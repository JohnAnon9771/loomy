.DS_Store

# File-manager / editor artifacts.
.!*

# Test and benchmark scratch output. Fixtures (test/assets) and golden
# references (test/assets/references) are committed and must stay tracked.
test/tmp/
bench/tmp/

# RubyCritic report output.
tmp/

# Where examples/ecommerce_banner.rb writes when it is run with no --out.
/banner.png
/banners/

# A library does not commit its lockfile: each supported Ruby resolves its own
# compatible set.
/.bundle/
Gemfile.lock
